{
  "name": "layercache",
  "version": "4.0.0",
  "description": "Production-ready multi-layer caching for Node.js. Stack memory + Redis + disk behind one API with stampede prevention, tag invalidation, stale serving, and full observability.",
  "keywords": [
    "cache",
    "caching",
    "multi-layer",
    "redis",
    "memory",
    "disk",
    "stampede",
    "invalidation",
    "tag-invalidation",
    "stale-while-revalidate",
    "circuit-breaker",
    "typescript",
    "nodejs",
    "express",
    "fastify",
    "hono",
    "trpc",
    "graphql",
    "opentelemetry",
    "cache-manager",
    "lru-cache",
    "ttl",
    "backfill"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flyingsquirrel0419/layercache"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "layercache": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "require": "./dist/edge.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/edge.ts --format esm,cjs --dts --clean",
    "build:all": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "test:all": "npm test && npm run test:integration",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "bench:latency": "tsx benchmarks/latency.ts",
    "bench:stampede": "tsx benchmarks/stampede.ts",
    "bench:direct": "tsx benchmarks/direct.ts",
    "bench:http": "tsx benchmarks/http.ts",
    "bench:edge": "tsx benchmarks/edge.ts",
    "bench:slow-redis": "tsx benchmarks/slow-redis.ts",
    "bench:memory-pressure": "tsx benchmarks/memory-pressure.ts",
    "bench:queue-amplification": "tsx benchmarks/queue-amplification.ts",
    "bench:multi-process-fanout": "tsx benchmarks/multi-process-fanout.ts",
    "bench:all": "npm run bench:direct && npm run bench:edge && npm run bench:slow-redis && npm run bench:queue-amplification && npm run bench:http && npm run bench:multi-process-fanout"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "async-mutex": "^0.4.1"
  },
  "peerDependencies": {
    "ioredis": ">=5.0.0"
  },
  "optionalDependencies": {
    "ioredis": ">=5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.15.2",
    "@vitest/coverage-v8": "^4.1.2",
    "autocannon": "^2.0.1",
    "ioredis": "^5.6.1",
    "ioredis-mock": "^8.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
